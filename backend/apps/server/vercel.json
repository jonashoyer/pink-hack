{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/server.mjs": { "maxDuration": 300 },
    "api/device.mjs": { "maxDuration": 300 }
  },
  "routes": [
    { "src": "/api/v1/device/audio", "dest": "/api/device" },
    { "src": "/presentation", "status": 308, "headers": { "Location": "/presentation/" } },
    { "src": "/presentation/", "dest": "/presentation/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/server" }
  ]
}
